    <!-- Accessibility / admin descriptions shown in system settings -->
    <string name="accessibility_service_label">Locky app lock</string>
    <string name="accessibility_service_description">Watches which app moves to the foreground and shows the Locky PIN screen when that app is one you protected. Nothing is read, typed, or sent anywhere.</string>
    <string name="device_admin_description">Lets Locky stop itself from being uninstalled while its lock is enabled. Locky cannot read your data, change your settings, or lock your device.</string>
